# Copy to .env (git-ignored) and fill in. Never commit real values.
# PayPal Sandbox REST app credentials: developer.paypal.com -> Apps & Credentials -> Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional; must be the sandbox host (the spike refuses anything else)
# PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Anthropic API key for the LLM tool-calling spike
ANTHROPIC_API_KEY=
# Optional model override for the LLM spike
# SPIKE_LLM_MODEL=claude-sonnet-5-5

# --- Phase 3: Gemini autonomous agent ---
# Google AI Studio API key (https://aistudio.google.com/apikey). GOOGLE_API_KEY is accepted as a fallback.
GEMINI_API_KEY=
# Model id to use (the code has one default in agent/payments/models.py; set this to a model your key can access)
# GEMINI_MODEL=
# Optional paths
# INOEMA_PAYMENT_DB=data/payment_simulations.db
# INOEMA_AGENT_DB=data/payment_agent_runs.db

# --- Phase 4: PayPal Sandbox (SANDBOX ONLY: the code refuses live hosts and PAYPAL_ENV != sandbox) ---
# Sandbox REST app credentials from developer.paypal.com -> Apps & Credentials -> Sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_ENV=sandbox
# INOEMA_PAYPAL_DB=data/paypal_sandbox.db

# --- Phase 5: dashboard ---
# Payments is the default workspace. To open the original Simulation Control Center instead: INOEMA_DEFAULT_WORKSPACE=simulation
# Start in Demonstration mode (historical persisted data only; live agent/Sandbox actions disabled): INOEMA_DEMO_MODE=1
# Skip the automatic MCP-server check on the Overview page: INOEMA_DASHBOARD_AUTOCHECK=0
